{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wambe.africa/contracts/staging-evidence-v1.schema.json",
  "title": "Wambe staging release evidence v1",
  "description": "Redacted, machine-checkable evidence for the US-003 staging-readiness decision. The schema cannot detect secrets; producers must apply the documented redaction policy.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "storyId",
    "environment",
    "release",
    "controls"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "storyId": {
      "const": "US-003"
    },
    "environment": {
      "const": "staging"
    },
    "release": {
      "$ref": "#/$defs/release"
    },
    "controls": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/controlEvidence"
      }
    }
  },
  "$defs": {
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit"
      ],
      "properties": {
        "commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40,64}$"
        },
        "apiImageDigest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "scannerImageDigest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "vercelDeploymentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      }
    },
    "controlEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "controlId",
        "status"
      ],
      "properties": {
        "controlId": {
          "type": "string",
          "pattern": "^[A-Z0-9][A-Z0-9._-]{1,63}$"
        },
        "status": {
          "enum": [
            "NOT_RUN",
            "IN_PROGRESS",
            "PASS",
            "FAIL",
            "BLOCKED",
            "WAIVED"
          ]
        },
        "timestampUtc": {
          "type": "string",
          "format": "date-time"
        },
        "reviewerRole": {
          "enum": [
            "Backend",
            "Frontend",
            "QA",
            "Security",
            "Operations",
            "Product Owner"
          ]
        },
        "reviewerReference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "sourceReferences": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        },
        "outcome": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "defectReference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "decisionReference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "not": {
                  "const": "NOT_RUN"
                }
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "timestampUtc",
              "reviewerRole",
              "reviewerReference",
              "sourceReferences",
              "outcome"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "FAIL"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "defectReference"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "WAIVED"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "decisionReference"
            ]
          }
        }
      ]
    }
  }
}
